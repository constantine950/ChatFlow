# ─────────────────────────────────────────────
#  ChatFlow — Production environment
#  Copy to .env.prod and fill in real values
# ─────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=chatflow
POSTGRES_PASSWORD=<strong_random_password>
POSTGRES_DB=chatflow

# Redis
REDIS_PASSWORD=<strong_random_password>

# MinIO
MINIO_ROOT_USER=chatflow_minio
MINIO_ROOT_PASSWORD=<strong_random_password>

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=<64_char_random_hex>

# URLs — replace with your domain
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
NEXT_PUBLIC_WS_URL=wss://yourdomain.com
