PORT=8080
ENV=development

# Postgres — matches docker-compose.yml defaults
DATABASE_URL=postgres://chatflow:chatflow_secret@localhost:5432/chatflow?sslmode=disable

# Redis — matches docker-compose.yml defaults
REDIS_URL=redis://:redis_secret@localhost:6379/0

# JWT — change this to any long random string
JWT_SECRET=super_secret_change_me_in_production_please

# Kafka (Redpanda external port)
KAFKA_BROKERS=localhost:19092

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret
MINIO_BUCKET=chatflow
